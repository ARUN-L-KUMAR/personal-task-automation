{
  "expo": {
    "name": "Personal Task",
    "slug": "personal-task-mobile",
    "scheme": "personaltask",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#F3F7FB"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.personaltask.mobile"
    },
    "plugins": [
      "expo-secure-store",
      "expo-asset",
      "expo-notifications"
    ]
  }
}
