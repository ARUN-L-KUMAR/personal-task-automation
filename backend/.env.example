# -------- AI / LLM Configuration --------
# OpenRouter API Key (get free key at: https://openrouter.ai/)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: Override default model
# AI_MODEL_NAME=deepseek/deepseek-r1
# AI_TEMPERATURE=0.3

# Google Gemini API Key (fallback model — get free at: https://aistudio.google.com/apikey)
GOOGLE_API_KEY=your_google_api_key_here

# -------- Neon PostgreSQL Database --------
# Get your connection string from https://console.neon.tech
# Format: postgresql+psycopg2://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql+psycopg2://your_user:your_password@ep-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# -------- JWT Authentication --------
JWT_SECRET_KEY=change-me-to-a-random-64-char-string
JWT_EXPIRE_MINUTES=1440

# -------- Google Services Configuration --------
# Google Maps API Key (from Google Cloud Console)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Google OAuth2 Setup:
# 1. Go to Google Cloud Console → APIs & Services → Credentials
# 2. Create an OAuth 2.0 Client ID (Web application type)
# 3. Download the JSON and save as 'credentials.json' in backend/ folder
# 4. Add http://localhost:8000/api/auth/google/callback as authorized redirect URI
# 5. Enable these APIs in your Google Cloud project:
#    - Google Calendar API
#    - Gmail API
#    - People API (Contacts)
#    - Google Sheets API
#    - Google Tasks API
#    - Directions API (Maps)
